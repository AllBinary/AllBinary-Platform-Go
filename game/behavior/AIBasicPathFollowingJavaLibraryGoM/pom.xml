                                <GOCACHE>${go.cache}</GOCACHE>
                                <GO111MODULE>off</GO111MODULE>
                            </environmentVariables>
                            <arguments>
                                <argument>env</argument>
                                <argument>GOROOT</argument>
                                <argument>GOPATH</argument>
                                <argument>GOCACHE</argument>
                                <argument>GO111MODULE</argument>
                                <argument>GOOS</argument>
                                <argument>GOARCH</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-go-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${go.home}/bin/go</executable>
                            <workingDirectory>${go.path}/src/org/allbinary</workingDirectory>
                            <environmentVariables>
                                <GOPATH>${go.path}</GOPATH>
                                <GOCACHE>${go.cache}</GOCACHE>
                                <GO111MODULE>off</GO111MODULE>
                                <GOFLAGS></GOFLAGS>
                            </environmentVariables>
                            <arguments>
                                <argument>build</argument>
                                <!-- Lists each package as it is compiled - TWB seems to be useless -->
<!--                                <argument>-v</argument>-->
                                <!-- Prints each command go build runs such as compile and link with their arguments -->
<!--                                <argument>-x</argument>-->
                                <!-- Reports all the compile errors instead of stopping after 10 -->
                                <argument>-gcflags=-e</argument>
                                <argument>./...</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

</project>
