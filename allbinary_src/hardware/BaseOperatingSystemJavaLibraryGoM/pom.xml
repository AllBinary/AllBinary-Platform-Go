<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.allbinary</groupId>
    <artifactId>BaseOperatingSystemJavaLibraryGo</artifactId>
    <packaging>jar</packaging>
    <!-- AllBinary Platform Version Start -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->

    <name>BaseOperatingSystemJavaLibraryGo</name>
    <url>http://www.allbinary.com/</url>
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Go install directory. The Windows installer default is C:/Program Files/Go -->
        <go.home>C:/Go</go.home>
        <!-- Generated imports are Java package paths such as org/allbinary/string so the build uses a GOPATH source tree -->
        <go.path>${project.build.directory}/go</go.path>
        <!-- Go build cache in target so mvn clean clears it and the next go build -x shows every compile and link command -->
        <go.cache>${project.build.directory}/go-cache</go.cache>
        <!-- Hand written runtime for generated Go code such as Any -->
        <go.runtime.source.path>G:/mnt/bc/mydev/workgo/j2me/J2SEForGoLibraryGoM/src/main/java</go.runtime.source.path>
        <go.jsinterop.source.path>G:/mnt/bc/mydev/workinggo/replace_these_stub_projects/allbinary_src/J2MEJsInteropCompatibilityJavaLibraryGoM/src/main/java</go.jsinterop.source.path>
    </properties>

    <dependencies>
        <!--
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>
        -->

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>J2MEJsInteropCompatibilityJavaLibraryGo</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LoggingJ2MEAllGo</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LogJ2MEJavaLibraryGo</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>BasePreloaderJ2MEJavaLibraryGo</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Java packages can import each other in cycles and Go packages can not so all Go sources are flattened into the org/allbinary package.
                 Java ag packages are the 2nd package org/allbinary/game/ag. The farthest dependency is copied first so the nearest copy of a class wins like Maven. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-go-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <macrodef name="copygo">
                                    <attribute name="dir" />
                                    <sequential>
                                        <copy todir="${go.path}/src/org/allbinary" flatten="true" overwrite="true">
                                            <fileset dir="@{dir}" includes="**/*.go" excludes="**/ag/**" erroronmissingdir="false" />
                                        </copy>
                                        <copy todir="${go.path}/src/org/allbinary/game/ag" flatten="true" overwrite="true">
                                            <fileset dir="@{dir}" includes="**/ag/**/*.go" erroronmissingdir="false" />
                                        </copy>
                                    </sequential>
                                </macrodef>
                                <delete dir="${go.path}/src" quiet="true" />
                                <copygo dir="${go.runtime.source.path}" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/allbinary_src/allbinary_src_designpatterns_srcGoM/src/main/java" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/j2me/J2MEExceptionLibraryGoM/src/main/java" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/j2me/CommonJavaLibraryGoM/src/main/java" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/allbinary_src/LogGoM/src/main/java" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/j2me/TempBaseJavaLibraryGoM/src/main/java" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/allbinary_src/logic/BasePreloaderJ2MEJavaLibraryGoM/src/main/java" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/allbinary_src/LogJ2MEJavaLibraryGoM/src/main/java" />
                                <copygo dir="G:/mnt/bc/mydev/workinggo/j2me/logging/LoggingJ2MEAllGoM/src/main/java" />
                                <copygo dir="${go.jsinterop.source.path}" />
                                <copygo dir="${project.basedir}/src/main/java" />
                                <!-- Shows what go build compiles -->
                                <resourcecount property="go.file.count">
                                    <fileset dir="${go.path}/src" includes="**/*.go" />
                                </resourcecount>
                                <echo level="info" message="Go files to compile: ${go.file.count} in ${go.path}/src/org/allbinary" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- The Go version and environment the build uses -->
                    <execution>
                        <id>go-version</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${go.home}/bin/go</executable>
                            <environmentVariables>
                                <GOPATH>${go.path}</GOPATH>
                                <GO111MODULE>off</GO111MODULE>
                            </environmentVariables>
                            <arguments>
                                <argument>version</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>go-env</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${go.home}/bin/go</executable>
                            <environmentVariables>
                                <GOPATH>${go.path}</GOPATH>
                                <GOCACHE>${go.cache}</GOCACHE>
                                <GO111MODULE>off</GO111MODULE>
                            </environmentVariables>
                            <arguments>
                                <argument>env</argument>
                                <argument>GOROOT</argument>
                                <argument>GOPATH</argument>
                                <argument>GOCACHE</argument>
                                <argument>GO111MODULE</argument>
                                <argument>GOOS</argument>
                                <argument>GOARCH</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-go-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${go.home}/bin/go</executable>
                            <workingDirectory>${go.path}/src/org/allbinary</workingDirectory>
                            <environmentVariables>
                                <GOPATH>${go.path}</GOPATH>
                                <GOCACHE>${go.cache}</GOCACHE>
                                <GO111MODULE>off</GO111MODULE>
                                <GOFLAGS></GOFLAGS>
                            </environmentVariables>
                            <arguments>
                                <argument>build</argument>
                                <!-- Lists each package as it is compiled - TWB seems to be useless -->
<!--                                <argument>-v</argument>-->
                                <!-- Prints each command go build runs such as compile and link with their arguments -->
<!--                                <argument>-x</argument>-->
                                <!-- Reports all the compile errors instead of stopping after 10 -->
                                <argument>-gcflags=-e</argument>
                                <argument>./...</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

</project>
